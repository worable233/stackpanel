# Dependencies (installed inside the image)
node_modules/
**/node_modules/
.pnpm-store/

# Build output (rebuilt in the image)
dist/
**/dist/
.next/
**/.next/
out/
**/out/
coverage/
**/coverage/
dist-pack/
**/dist-pack/
*.tsbuildinfo

# Prisma generated client (regenerated by `prisma generate` during install)
**/src/generated/

# Environment & secrets (provided via Compose env)
.env
.env.*
!*.env.example

# Runtime data & logs
data/
**/data/
var/
**/var/
logs/
**/logs/
*.log
.sp-testdata-*
.sp-themes-*
.sp-signing-*
.sp-frontend-*

# VCS / editor / tooling
.git
.gitignore
.DS_Store
.idea/
.vscode/
*.swp
.opencode-goal/
.qoder/
