# /etc/stackpanel/upgrade.env —— runner 环境（systemd EnvironmentFile）
#
# 这些值必须与 PM2 业务进程一致；runner 不读取内核的 .env。
STACKPANEL_ROOT=/opt/stackpanel
STACKPANEL_STATE_DIR=/var/lib/stackpanel
STACKPANEL_UPDATE_INSTANCE_ID=stackpanel
STACKPANEL_PM2_HOME=/home/stackpanel/.pm2
# 迁移与快照使用；无此值时跳过数据库快照（迁移仍会失败并保持维护）。
DATABASE_URL=postgresql://stackpanel:stackpanel@127.0.0.1:5432/stackpanel
# 保守保留 2 个 release（当前 + 上一版）。
STACKPANEL_RELEASE_RETENTION=2
