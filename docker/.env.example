# StackPanel production stack configuration.
# Copy to docker/.env, fill in strong secrets, then:
#   docker compose --env-file docker/.env up -d --build
#
# NEVER commit docker/.env.
#
# `bash scripts/deploy.sh` copies this file to docker/.env and fills the core
# secrets below with random values, so the placeholders never reach production
# through the script. Replace them by hand only if you configure docker/.env
# manually. Values shown as empty are intentionally empty and safe as-is.

# ---- Core secrets (REQUIRED, >= 32 chars, random) -----------------------
# Fill these in by hand, or let scripts/deploy.sh generate them. A non-empty
# placeholder here is a footgun: the API refuses to start on a short/known
# JWT_SECRET, so leave them EMPTY unless you are pasting real random values.
# openssl rand -base64 48 | tr -d '=+/' | head -c 48
JWT_SECRET=
# AES-256-GCM key for encrypted admin settings. Same rules as JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=

# ---- 内存 / 堆上限（插件一多就必须调） -----------------------------------
# 每个已装插件都会在 web（账号页/后台页渲染）和 worker（任务分发）里各常驻一份，
# 内存需求随插件数线性增长。默认值按「装 10+ 个插件」给的，**不要往下调**。
# 扩容公式：web = 1024 + N×128 MB，worker = 800 + N×128 MB，api = 768 + N×64 MB；
# 堆取限额的 ~75%（留 1/4 给 off-heap）。改完看启动横幅的
# `内存：heap <used>/<limit> MiB`，heapLimit 明显偏小说明 NODE_OPTIONS 没生效。
#
# 源码映射（构建期参数，不是 .env 变量）。entrypoint 默认启用
# `--enable-source-maps`，生产堆栈能落到原始行号。不要行号、只要体积时：
#   docker build --build-arg STACKPANEL_SOURCE_MAPS=0 …
# 实测镜像 4.06 GB → 3.67 GB（省 390 MB；`.map` 只是 13 MB，大头是它带着
# tsup 的 chunk 一起被裁掉）。
#WEB_MEM_LIMIT=2048m
#WEB_NODE_OPTIONS=--max-old-space-size=1536
#WORKER_MEM_LIMIT=1600m
#WORKER_NODE_OPTIONS=--max-old-space-size=1200
#API_MEM_LIMIT=1024m
#API_NODE_OPTIONS=--max-old-space-size=768

# ---- updater / Docker socket ---------------------------------------------
# GID of /var/run/docker.sock. The updater runs as non-root `node` and needs
# `group_add` to talk to the socket; the GID differs per host (999 on most
# Linux, other values on Docker Desktop). `scripts/deploy.sh` fills this in
# automatically; set it by hand only if you configured docker/.env yourself.
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# ---- Bundled infrastructure (default compose only) -----------------------
# Password for the bundled PostgreSQL and the MinIO root user. Generated by
# scripts/deploy.sh. Ignored when using docker-compose.cluster.yml.
POSTGRES_USER=stackpanel
POSTGRES_DB=stackpanel
POSTGRES_PASSWORD=
MINIO_ROOT_USER=stackpanel
MINIO_ROOT_PASSWORD=
STORAGE_S3_BUCKET=stackpanel

# ---- URLs ---------------------------------------------------------------
# Externally reachable web URL (used for OIDC redirects, store notify links).
STACKPANEL_PUBLIC_URL=http://localhost:3000
# Externally reachable API URL (same origin as STACKPANEL_PUBLIC_URL when a
# reverse proxy serves both under one host).
STACKPANEL_API_PUBLIC_URL=http://localhost:3001
# BFF target inside the compose network. Change only for non-compose layouts.
API_BASE_URL=http://api:3001

# ---- Image distribution (IMG-DIST) ---------------------------------------
# Pin a published image (GHCR) instead of the locally built stackpanel-*:latest.
# api / worker / web share this one image; roles are chosen by entrypoint.
# Prefer an immutable digest for production, e.g.
#   STACKPANEL_IMAGE=ghcr.io/<owner>/stackpanel@sha256:<digest>
# `bash scripts/deploy.sh --image <ref>` writes this for you. See docker/README.md.
STACKPANEL_IMAGE=
# 目标镜像仓库前缀（不含 digest）；updater 切换时拼成 `<repo>@sha256:<digest>`。
# 也是集群档的必填项。默认指向官方镜像。
STACKPANEL_IMAGE_REPOSITORY=ghcr.io/worable233/stackpanel
# 独立升级执行器镜像（apps/updater/Dockerfile）。默认档本地构建；发布版钉到摘要。
STACKPANEL_UPDATER_IMAGE=
# 仓库在宿主上的**绝对**路径。updater 从容器内执行 `docker compose` 自升级时，
# 相对绑定路径会被解析成容器内路径，导致新容器挂载到空目录；`deploy.sh` 自动写入。
STACKPANEL_HOST_DIR=
# updater 绑定的实例 ID 与轮询间隔（§5.1）。
UPDATER_INSTANCE_ID=stackpanel
UPDATER_POLL_INTERVAL_MS=5000
# 独立恢复入口（§5.2）：至少 16 字符的独立令牌；端口 0 = 不监听。默认只回环，
# 需要管理网访问时显式给 UPDATER_RECOVERY_HOST。永远不要与业务 JWT 共用。
UPDATER_RECOVERY_TOKEN=
UPDATER_RECOVERY_PORT=0
UPDATER_RECOVERY_HOST=127.0.0.1
# updater self-update (§5.2): service name + the env var carrying its image ref.
# Defaults match docker-compose.yml; override only for a renamed service.
UPDATER_SELF_SERVICE=updater
UPDATER_SELF_IMAGE_ENV=STACKPANEL_UPDATER_IMAGE
# Repository of the updater image itself (NOT the kernel image). Self-update pulls
# `<repo>@sha256:<candidate>`; leaving it empty derives the repo from the running
# updater image reference. Set explicitly for private registries / mirrors.
# UPDATER_SELF_IMAGE_REPOSITORY=ghcr.io/worable233/stackpanel-updater

# ---- GitHub distribution & update centre --------------------------------
# The kernel SHIPS a default signed catalog source: leave this empty (or set it
# to the default) to browse & install official plugins/themes out of the box.
#   DISTRIBUTION_CATALOG_REPOSITORY=worable233/stackpanel-plugins
# Set `off` (or `none`/`false`) for a fully offline self-host: no outbound
# catalog request, and the market/update centre show local state only.
# An `owner/repo` slug or a full https://github.com/owner/repo URL is accepted.
# DISTRIBUTION_CATALOG_TOKEN is optional (private catalog / higher rate limit)
# and is never exposed to browsers or plugins.
DISTRIBUTION_CATALOG_REPOSITORY=
DISTRIBUTION_CATALOG_CHANNEL=stable
DISTRIBUTION_CATALOG_REF=main
DISTRIBUTION_CATALOG_TOKEN=
# Optional GitHub mirror/proxy prefix (ghproxy style): https://github.chenc.dev or
# https://ghfast.top. Requests to github.com/api.github.com/raw/codeload are sent
# as <mirror>/<original-url>; signatures and digests are still verified, and the
# mirror never receives the catalog token. Must be public HTTPS.
DISTRIBUTION_CATALOG_MIRROR=
# 目录签名公钥（PEM，单行或多行均可）。启用远程目录后，实例必须能验证
# catalog.sig；这里填发布方那把 purpose=catalog 的公钥即可，无需手写 keyring。
# 它只用于目录签名，且仅对上面的目录仓生效。
DISTRIBUTION_CATALOG_PUBLIC_KEY=
# Local market sources (the plugins/themes that ship inside the image) are
# DISABLED automatically in containers/production: installs must come from the
# signed catalog. `on` only takes effect outside a container; `off` forces it.
STACKPANEL_MARKET_LOCAL_SOURCES=
# Docker target platform used to pick the kernel image digest for updates.
DISTRIBUTION_DEPLOY_PLATFORM=linux/amd64
# Update task channel + updater status projection. Defaults match the shared
# `stackpanel-updater-state` volume mounted into api and worker; only override
# if you lay the updater state out differently.
DISTRIBUTION_UPDATE_CHANNEL_DIR=
DISTRIBUTION_UPDATER_STATUS_FILE=

# ---- Optional hardening / behaviour --------------------------------------
# Terminated by a reverse proxy that speaks HTTPS? Keep true.
API_COOKIE_SECURE=true
# Which peers may supply `X-Forwarded-For` (i.e. which addresses are reverse
# proxies). This is what makes per-IP rate limits, captcha cooldowns, bans and
# audit logs see the **visitor** instead of the proxy.
#
# `loopback,linklocal,uniquelocal` = 127.0.0.0/8 + link-local + **all** RFC1918
# private ranges (10/8, 172.16/12, 192.168/16). Docker and panel networks
# (1Panel's 172.18.x, 宝塔, 群晖) all fall inside those, so the common layouts work
# without editing this. It is still safe: only a peer that really is one of those
# addresses can influence the header, so spoofing from the public internet does
# nothing. A public reverse proxy / CDN must be added explicitly.
#
#   API_TRUST_PROXY=loopback,linklocal,uniquelocal,203.0.113.0/24   # + a public proxy
#   API_TRUST_PROXY=false    # escape hatch: ignore X-Forwarded-For entirely
#
# Do NOT hard-code the compose subnet here. This file is copied to `.env` by
# every operator, and a fixed `172.28.0.0/16` silently stops matching as soon as
# the proxy lives on another network (1Panel, an external nginx, a CDN) — that is
# exactly the "everyone shares one IP" incident. Verify the result with
# `GET /api/v1/system/proxy-check` (see docker/README.md §5).
API_TRUST_PROXY=loopback,linklocal,uniquelocal

# Single-port mode: let the Web container forward the kernel's machine-facing
# prefixes (/api/v1, /themes, /plugins, ...) too, so the reverse proxy only
# needs ONE upstream (3000). This removes the entire class of "prefix missing /
# swallowed by the panel's `location ^~ /`" misconfigurations.
#
# Off by default because it moves the boundary between the two upstreams into
# Web. Turn it on if you deploy behind a panel (1Panel / 宝塔 / 群晖) and want
# the simplest possible proxy config. See docs/DEPLOY-REVERSE-PROXY.md §4.
STACKPANEL_SINGLE_PORT=0
# Comma-separated browser origins allowed to call the API directly (default none).
API_CORS_ORIGINS=
API_LOG_LEVEL=info
SESSION_COOKIE_NAME=sp_session
SESSION_TTL_SECONDS=43200

# First-run setup wizard. A fresh instance is claimed from the browser at
# /setup by creating the first administrator — no password is ever written to
# the logs. STACKPANEL_SETUP_MODE=auto (default) enables the wizard; set it to
# `disabled` to require out-of-band provisioning instead.
STACKPANEL_SETUP_MODE=auto
# One-time claim token. When set, completing /setup requires it, which closes
# the "squat the fresh instance" race on an internet-reachable host. Generated
# by scripts/deploy.sh and printed in its summary. Leave empty to run the wizard
# open (acceptable only on a trusted network until the instance is claimed).
STACKPANEL_SETUP_TOKEN=
# Package signing. Default true in production = uploads a
STACKPANEL_SIGNING_PUBLIC_KEY=
PACKAGE_SIGNATURE_REQUIRED=true

# Wow ID OpenID Connect. Register this exact HTTPS callback in Wow ID before
# enabling the plugin. Mock mode is only for local automated tests.
WOWID_MOCK=false
WOWID_ISSUER=https://account.wowcraft.cn
WOWID_CLIENT_ID=stackpanel
# Only needed when enabling Wow ID login; leave empty otherwise.
WOWID_CLIENT_SECRET=
WOWID_REDIRECT_URI=

# ---- HTTPS (Caddy, optional profile) -------------------------------------
# Public domain pointing at this host; enables automatic Let's Encrypt TLS.
STACKPANEL_DOMAIN=
# Let's Encrypt notification email (optional).
STACKPANEL_EMAIL=
# CDN / external load balancer egress CIDRs (space separated), e.g.
#   173.245.48.0/20 103.21.244.0/22      # Cloudflare
# Leave empty when Caddy receives client connections directly. When a CDN sits
# in front, Caddy otherwise sees the CDN's IP for every visitor, breaking
# per-IP rate limits and audit logs. NEVER use a range clients can join — they
# could spoof X-Forwarded-For.
STACKPANEL_TRUSTED_PROXIES=
