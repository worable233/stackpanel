# StackPanel Caddyfile — automatic HTTPS for the web UI and the API.
# Used by the optional `caddy` service in docker-compose*.yml (profile: https).
# Environment variables are substituted by Caddy at startup.

{
	# Quote the value: an empty env var must still adapt to an empty `email`
	# argument. Unquoted `email {$...}` with an empty value drops the argument and
	# Caddy aborts with "wrong argument count" (breaking `--domain` without
	# `--email`). Quoting keeps an empty string a valid argument.
	email "{$STACKPANEL_EMAIL}"

	# CDN / external load balancer support (off by default).
	#
	# When a CDN (Cloudflare, CloudFront, ALB, …) or another reverse proxy sits in
	# front of Caddy, the immediate peer is that proxy, so Caddy would otherwise
	# forward the proxy's own address in `X-Forwarded-For` — the API then sees one
	# IP for the whole internet, collapsing per-IP rate limits and audit trails.
	#
	# Enable by setting STACKPANEL_TRUSTED_PROXIES to the CDN's egress CIDRs
	# (space/comma separated, e.g. `173.245.48.0/20 103.21.244.0/22`). Never set
	# this to a range clients can join, or they can spoof `X-Forwarded-For` and
	# evade rate limits. The default `0.0.0.0/32` trusts nothing.
	#
	# `trusted_proxies_strict` parses right-to-left, which is required for CDNs
	# that APPEND the real client IP (Cloudflare/ALB/CloudFront).
	servers {
		trusted_proxies static {$STACKPANEL_TRUSTED_PROXIES:0.0.0.0/32}
		trusted_proxies_strict
	}
}

{$STACKPANEL_DOMAIN} {
	# HSTS (security audit M-2). Caddy already adds this by default on
	# HTTPS, but pinning it here makes the policy explicit and keeps it in sync
	# with the API/web header values even if Caddy's defaults change.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# ------------------------------------------------------------------------
	# API machine surface (external clients hit these directly, bypassing the
	# web BFF): open platform, MCP, SP v1, ZJMF compat, payment callbacks, and
	# API-served theme/plugin assets.
	#
	# Prefix-preserving reverse proxy: the upstream path must stay exactly as
	# received (`/api/v1/platform` → api `/api/v1/platform`). Do NOT use
	# `handle_path`, which strips the matched prefix and would turn it into
	# `/v1/platform` (404). Web BFF routes live under `/api/notifications`,
	# `/api/llm-gateway/*`, `/api/catalog/*`, `/api/store/*` — those match the
	# `handle` fallback below, never this block.
	#
	# `flush_interval -1` disables response buffering so SSE / streaming
	# passthrough (llm-gateway, backup download) reaches the client per write.
	# `encode gzip` must NOT wrap these responses: compressing `text/event-stream`
	# buffers events and breaks SSE clients.
	# ------------------------------------------------------------------------
	@api path /api/v1/* /api/product* /mcp /sp/v1/* /llm-gateway/* /callbacks/* \
		/zjmf_api_login /cart/* /host/* /provision/* \
		/themes/* /plugins/* /media/* /platform/* /health /ready
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			flush_interval -1
			# Keep in-flight streams alive across a Caddy config reload instead of
			# dropping every SSE/proxy connection (matches the kernel's 30s drain).
			stream_close_delay 30s
		}
	}

	# ------------------------------------------------------------------------
	# Web (Next.js): the UI plus the BFF `/api/*` routes. This is the fallback;
	# the API matcher above must be checked first.
	# ------------------------------------------------------------------------
	handle {
		encode gzip
		reverse_proxy {$WEB_UPSTREAM}
	}
}
