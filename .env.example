# StackPanel root environment.
# Copy to .env and fill in real values. Never commit .env files.
#
# 注意：下面这些项**只是兜底**，不是权威（ADR-0026）。内核把「可运行期调整」的配置
# 存在数据库 `Setting` 表里（键 `config.<变量名>`），后台「设置 → 运行期配置」改完立即
# 对所有副本生效、不需要重启，也不需要改这里或 Compose。数据库没有对应行时才读这里：
#   AUTH_CAPTCHA_MODE / AUTH_CODE_* / SESSION_COOKIE_NAME / SESSION_TTL_SECONDS /
#   MEDIA_MAX_UPLOAD_BYTES / MEDIA_VARIANTS_ASYNC / OPEN_API_TOKEN_* /
#   STACKPANEL_API_TOKEN_PREFIX / PACKAGE_SIGNATURE_REQUIRED / AUDIT_LOG_RETENTION_DAYS /
#   AGENT_PUBLIC_ORIGIN / AGENT_WEB_ORIGIN
# 仍然只能在这里配的：引导（DATABASE_URL、数据目录、监听地址）、密钥（JWT_SECRET、
# SETTINGS_ENCRYPTION_KEY）、基础设施（REDIS_URL、STORAGE_*）、启动期一次性（日志、
# CORS、连接池、OTEL、METRICS、SETUP）。详见 docs/design/runtime-config.md。

# Node
NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=3001
API_LOG_LEVEL=info
# Browser CORS is disabled by default. Comma-separate only origins that must call the API directly.
API_CORS_ORIGINS=
# Secure cookie flag: set true behind HTTPS.
API_COOKIE_SECURE=false
# Reverse-proxy trust for client IP (`req.ip`). Unset trusts `loopback` (the web
# BFF and same-host proxies); `true` trusts the immediate peer; `false` trusts
# nothing; otherwise a comma-separated list of addresses/CIDRs (or the presets
# `loopback` / `linklocal` / `uniquelocal`).
# Required for correct per-IP rate limiting behind Nginx/Caddy/a cloud LB: the
# BFF forwards the visitor's `X-Forwarded-For`, and the kernel only honours it
# when the forwarding peer is listed here. In Docker the web container is not on
# loopback, so compose sets this to the app network (e.g. `172.28.0.0/16`).
API_TRUST_PROXY=

# Database. PostgreSQL is the only supported engine (ADR-0019).
# postgresql://user:password@host:5432/stackpanel
DATABASE_URL=postgresql://stackpanel:stackpanel@127.0.0.1:5432/stackpanel

# Canonical data directory (plugins/themes/brand live here).
# Defaults to <repo-root>/data. Set an absolute path for production.
STACKPANEL_DATA_DIR=
# Optional sibling checkout(s) containing non-builtin plugin sources. Multiple
# paths may be separated with the platform path separator.
# STACKPANEL_PLUGIN_SOURCES=../StackPanel-plugins/packages/plugins

# Web-process server execution allowlist (ADR-0024 / contract 03 §3.1).
# A plugin's frontend `finders` run inside the WEB process, with the current
# user's kernel API client. That is a privilege the kernel grants, never
# something a package may self-declare. `builtin` packages are admitted by
# default; list plugin ids here (comma-separated) to admit an installed package.
#
# Prefer declarative page data (`data: [{ fetch: { path } }]`) over a finder:
# the host performs that request itself, so it needs no admission at all and
# works for any plugin. Use a finder only when the data cannot be expressed as
# one HTTP call.
#
# Without admission, `finder`-based `data[...]` comes back empty (the page still
# renders). Denying by default is deliberate: an unlisted plugin must not
# execute server-side code in the web process.
# STACKPANEL_FRONTEND_SERVER_EXEC=ticket,notice
#
# Inverse control: drop the default grant from a built-in package (comma-
# separated ids). Deny wins over both `builtin` and the allowlist above, so
# "ships with the kernel" and "may run code in the web process" stay independent.
# STACKPANEL_FRONTEND_SERVER_EXEC_DENY=

# Stable replica identity (durable event consumption). Each replica keeps its own
# outbox cursor keyed by this value, so it must be stable across restarts and
# unique per replica — otherwise a restarted replica replays from "now" and a
# shared id would make replicas fight over one cursor. Falls back to the
# hostname. k8s: use a StatefulSet pod name (`metadata.name`).
# STACKPANEL_INSTANCE_ID=
# On first boot with no cursor, replay at most this far back (ms). 0 (default)
# means "only events from now on" — set a window to backfill recent history.
# STACKPANEL_OUTBOX_REPLAY_WINDOW_MS=0

# Infrastructure (ADR-0017). Development may omit these: Redis falls back to an
# in-process implementation and object storage falls back to the local disk.
# Production REQUIRES REDIS_URL and STORAGE_DRIVER=s3 (the process refuses to
# start otherwise).
# REDIS_URL=redis://127.0.0.1:6379
# STORAGE_DRIVER=local            # local | s3
# STORAGE_LOCAL_ROOT=             # defaults to <data-dir>/storage
# STORAGE_PUBLIC_BASE_URL=        # public base URL for stored objects
# STORAGE_S3_ENDPOINT=            # e.g. http://127.0.0.1:9000 (MinIO)
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=stackpanel
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true

# Media (ADR-0014). Upload ceiling per object, in bytes (default 25 MiB). Async
# variant generation runs on the worker (BullMQ) by default; set
# MEDIA_VARIANTS_ASYNC=false to fall back to synchronous inline encoding.
# MEDIA_MAX_UPLOAD_BYTES=26214400
# MEDIA_VARIANTS_ASYNC=true
# Full-size WebP delivery encode: image uploads are re-encoded to WebP whenever
# that actually saves bytes (lossless for PNG/GIF/WebP sources, quality-82 for
# JPEG). MEDIA_WEBP_OPTIMIZE=false keeps the uploaded bytes untouched.
# MEDIA_WEBP_OPTIMIZE=true

# Web (Next.js)
WEB_PORT=3000
# Base URL of the StackPanel API (BFF proxy target).
API_BASE_URL=http://127.0.0.1:3001
# Plugin/theme frontends are loaded at runtime from STACKPANEL_DATA_DIR, so the
# web tier no longer rebuilds a registry or restarts on install. This variable
# was retired with that change and is intentionally no longer read by anything.
# Public browser/API origins used by external payment providers for return and notify URLs.
# In production both must be externally reachable HTTPS URLs.
STACKPANEL_PUBLIC_URL=http://127.0.0.1:3000
STACKPANEL_API_PUBLIC_URL=http://127.0.0.1:3001

# Open platform (/api/v1). Per-token quota, enforced via the shared StateService
# (Redis in a cluster). RPM is a 60s window; concurrency 0 disables the inflight cap.
OPEN_API_TOKEN_RPM=240
OPEN_API_TOKEN_CONCURRENCY=0

# Fixed-window rate limits for sensitive routes (OAuth, API-token issuance,
# admin writes, uploads) live in `apps/api/src/lib/rate-limit-policy.ts`. This
# multiplier only RAISES those ceilings (values <1 are clamped to 1), e.g. when
# the API sits behind another gateway. Leave unset for the defaults.
# API_RATE_LIMIT_MULTIPLIER=1

# Observability (ADR-0015). Metrics are always recorded; /metrics is scrapable
# only over loopback unless METRICS_TOKEN is set (then it requires
# `Authorization: Bearer <token>`). Set METRICS_ENABLED=false to omit the route.
METRICS_ENABLED=true
# METRICS_TOKEN=

# OpenTelemetry tracing. Off unless an OTLP HTTP endpoint is configured (the
# standard OTEL_* vars are honored). Web->API and event/job work continue one
# trace via the W3C traceparent header.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_ENABLED=false

# Audit-log retention (ADR-0015 §5). Days to keep rows; 0 disables pruning.
AUDIT_LOG_RETENTION_DAYS=180

# web->API client resilience (ADR-0015 §4). Timeout / retry / circuit breaker are
# on by default; retries apply to idempotent methods only (never POST/PATCH).
# API_RESILIENCE_ENABLED=true
# API_TIMEOUT_MS=10000
# API_RETRY_ATTEMPTS=3
# API_RETRY_BASE_DELAY_MS=100
# API_RETRY_MAX_DELAY_MS=2000
# API_RETRY_JITTER=0.25
# API_CIRCUIT_FAILURE_THRESHOLD=5
# API_CIRCUIT_SUCCESS_THRESHOLD=1
# API_CIRCUIT_COOLDOWN_MS=10000

# Sessions (JWT, HS256). JWT_SECRET must be >= 32 chars; generate strong values.
JWT_SECRET=change_me_at_least_32_characters_long
SESSION_COOKIE_NAME=sp_session
SESSION_TTL_SECONDS=43200

# Identity challenge runtime limits and captcha policy. Registration email
# verification is configured in Admin > Settings > Login and registration;
# it is no longer controlled by an environment variable. The delivery channel
# is supplied by a plugin via the identity.challengeSender extension point.
# AUTH_CAPTCHA_MODE=required fails closed when no captcha.provider is registered.
AUTH_CAPTCHA_MODE=off
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_SEND_PER_HOUR=5
AUTH_CODE_SEND_PER_HOUR_PER_IP=20
# Login plugin attempt ceilings per minute. Each is enforced twice: per client
# IP and per target account, so neither one attacker on many accounts nor many
# attackers on one account can exhaust the budget. 0 disables the counter.
# Behind a reverse proxy these need API_TRUST_PROXY above to see real clients.
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_MAX=5

# First-run setup wizard. A fresh instance is claimed in the browser at /setup;
# no password is ever written to the logs. Set STACKPANEL_SETUP_MODE=disabled to
# require out-of-band provisioning instead. When STACKPANEL_SETUP_TOKEN is set,
# completing /setup requires it (closes the public squat-the-fresh-instance race).
STACKPANEL_SETUP_MODE=auto
STACKPANEL_SETUP_TOKEN=

# Settings encryption key (AES-256-GCM). Must be >= 32 chars if secrets are used.
SETTINGS_ENCRYPTION_KEY=change_me_at_least_32_characters_long

# Wow ID OpenID Connect. Register this exact HTTPS callback in Wow ID before
# enabling the plugin. Mock mode is only for local automated tests.
WOWID_MOCK=false
WOWID_ISSUER=https://account.wowcraft.cn
WOWID_CLIENT_ID=stackpanel
WOWID_CLIENT_SECRET=
WOWID_REDIRECT_URI=https://stackpanel.example/auth/oauth/wowid/callback

# Package signing. Production defaults to requiring signatures and a public key.
STACKPANEL_SIGNING_PUBLIC_KEY=
PACKAGE_SIGNATURE_REQUIRED=false

# ---- GitHub distribution & application market ---------------------------
# The kernel ships a default signed catalog source; leave empty to use it, or
# set `off` for a fully offline instance (no outbound catalog request).
# Accepts `owner/repo` or https://github.com/owner/repo.
DISTRIBUTION_CATALOG_REPOSITORY=
DISTRIBUTION_CATALOG_CHANNEL=stable
DISTRIBUTION_CATALOG_REF=main
DISTRIBUTION_CATALOG_TOKEN=
# Optional GitHub mirror/proxy prefix (ghproxy style), e.g. https://github.chenc.dev
# or https://ghfast.top. Only the transport path changes: signatures, digests and
# sizes are still verified, and the mirror never receives the catalog token.
DISTRIBUTION_CATALOG_MIRROR=
# Catalog signing public key (PEM). Optional: when the repository above is the
# built-in default source, the kernel already ships its catalog key, so the
# default marketplace verifies out of the box. Set this only to override it
# (custom/private catalog). Bound to the repository above and never used for
# package signatures.
DISTRIBUTION_CATALOG_PUBLIC_KEY=
# keyId of the catalog key above; must match `catalog.sig.keyId` (default source:
# catalog-2026). Only needed when overriding the built-in key.
DISTRIBUTION_CATALOG_KEY_ID=
# Local market sources (packages/ in this repo) are disabled automatically when
# running in a container/production. `on` only applies outside a container.
STACKPANEL_MARKET_LOCAL_SOURCES=

# ---- Kernel/plugin update carrier (ADR-0023 / ADR-0025) ------------------
# `oci` (default) upgrades by switching the kernel image through the updater
# container; `artifact` upgrades by unpacking a prebuilt release tarball through
# the systemd upgrade runner. Keep the default unless you deploy artifacts.
DISTRIBUTION_UPDATE_CARRIER=
# Instance id shared by the API and the updater. If the two disagree, submitted
# tasks are never claimed (the update center shows an idle deployment forever).
DISTRIBUTION_UPDATE_INSTANCE_ID=
# Directory the API writes update tasks into and the updater consumes.
# Artifact deployments: <STACKPANEL_STATE_DIR>/update.
DISTRIBUTION_UPDATE_CHANNEL_DIR=
# Updater status projection, written by the runner and read (read-only) by the
# update center. Artifact deployments: <STACKPANEL_STATE_DIR>/update/status.json.
# When unset the API looks for status.json next to the channel directory.
DISTRIBUTION_UPDATER_STATUS_FILE=
# Root of the shared updater state volume (self-upgrade requests, journal,
# deployment pointer, backups). Defaults to the parent of the channel directory.
DISTRIBUTION_UPDATER_STATE_DIR=
# Platform of the artifacts to download when DISTRIBUTION_UPDATE_CARRIER=artifact.
DISTRIBUTION_DEPLOY_PLATFORM=

# Optional MCP OAuth issuer and human consent web origin. HTTPS in production.
# These enable discovery only after explicitly configuring both origins.
# AGENT_PUBLIC_ORIGIN=https://api.stackpanel.example
# AGENT_WEB_ORIGIN=https://stackpanel.example
