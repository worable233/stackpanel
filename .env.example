# StackPanel root environment.
# Copy to .env and fill in real values. Never commit .env files.

# Node
NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=3001
API_LOG_LEVEL=info
# Browser CORS is disabled by default. Comma-separate only origins that must call the API directly.
API_CORS_ORIGINS=
# Secure cookie flag: set true behind HTTPS.
API_COOKIE_SECURE=false
# Reverse-proxy trust for client IP (`req.ip`). Unset trusts nothing; true trusts
# the immediate peer; otherwise a comma-separated list of proxy addresses/CIDRs.
# Required for correct per-IP rate limiting behind Nginx/Caddy/a cloud LB.
API_TRUST_PROXY=

# Database. PostgreSQL is the only supported engine (ADR-0019).
# postgresql://user:password@host:5432/stackpanel
DATABASE_URL=postgresql://stackpanel:stackpanel@127.0.0.1:5432/stackpanel

# Canonical data directory (plugins/themes/brand live here).
# Defaults to <repo-root>/data. Set an absolute path for production.
STACKPANEL_DATA_DIR=

# Infrastructure (ADR-0017). Development may omit these: Redis falls back to an
# in-process implementation and object storage falls back to the local disk.
# Production REQUIRES REDIS_URL and STORAGE_DRIVER=s3 (the process refuses to
# start otherwise).
# REDIS_URL=redis://127.0.0.1:6379
# STORAGE_DRIVER=local            # local | s3
# STORAGE_LOCAL_ROOT=             # defaults to <data-dir>/storage
# STORAGE_PUBLIC_BASE_URL=        # public base URL for stored objects
# STORAGE_S3_ENDPOINT=            # e.g. http://127.0.0.1:9000 (MinIO)
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=stackpanel
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true

# Media (ADR-0014). Upload ceiling per object, in bytes (default 25 MiB). Async
# variant generation runs on the worker (BullMQ) by default; set
# MEDIA_VARIANTS_ASYNC=false to fall back to synchronous inline encoding.
# MEDIA_MAX_UPLOAD_BYTES=26214400
# MEDIA_VARIANTS_ASYNC=true

# Web (Next.js)
WEB_PORT=3000
# Base URL of the StackPanel API (BFF proxy target).
API_BASE_URL=http://127.0.0.1:3001
# When the kernel installs/upgrades/enables/disables a plugin, the web tier
# rebuilds the plugin frontend registry and restarts itself. Set 0 to disable
# and rebuild manually (`pnpm build`). See docs/architecture/ADR-0007.
STACKPANEL_FRONTEND_AUTOBUILD=1
# Public browser/API origins used by external payment providers for return and notify URLs.
# In production both must be externally reachable HTTPS URLs.
STACKPANEL_PUBLIC_URL=http://127.0.0.1:3000
STACKPANEL_API_PUBLIC_URL=http://127.0.0.1:3001

# Open platform (/api/v1). Per-token quota, enforced via the shared StateService
# (Redis in a cluster). RPM is a 60s window; concurrency 0 disables the inflight cap.
OPEN_API_TOKEN_RPM=240
OPEN_API_TOKEN_CONCURRENCY=0

# Fixed-window rate limits for sensitive routes (OAuth, API-token issuance,
# admin writes, uploads) live in `apps/api/src/lib/rate-limit-policy.ts`. This
# multiplier only RAISES those ceilings (values <1 are clamped to 1), e.g. when
# the API sits behind another gateway. Leave unset for the defaults.
# API_RATE_LIMIT_MULTIPLIER=1

# Observability (ADR-0015). Metrics are always recorded; /metrics is scrapable
# only over loopback unless METRICS_TOKEN is set (then it requires
# `Authorization: Bearer <token>`). Set METRICS_ENABLED=false to omit the route.
METRICS_ENABLED=true
# METRICS_TOKEN=

# OpenTelemetry tracing. Off unless an OTLP HTTP endpoint is configured (the
# standard OTEL_* vars are honored). Web->API and event/job work continue one
# trace via the W3C traceparent header.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_ENABLED=false

# Audit-log retention (ADR-0015 §5). Days to keep rows; 0 disables pruning.
AUDIT_LOG_RETENTION_DAYS=180

# web->API client resilience (ADR-0015 §4). Timeout / retry / circuit breaker are
# on by default; retries apply to idempotent methods only (never POST/PATCH).
# API_RESILIENCE_ENABLED=true
# API_TIMEOUT_MS=10000
# API_RETRY_ATTEMPTS=3
# API_RETRY_BASE_DELAY_MS=100
# API_RETRY_MAX_DELAY_MS=2000
# API_RETRY_JITTER=0.25
# API_CIRCUIT_FAILURE_THRESHOLD=5
# API_CIRCUIT_SUCCESS_THRESHOLD=1
# API_CIRCUIT_COOLDOWN_MS=10000

# Sessions (JWT, HS256). JWT_SECRET must be >= 32 chars; generate strong values.
JWT_SECRET=change_me_at_least_32_characters_long
SESSION_COOKIE_NAME=sp_session
SESSION_TTL_SECONDS=43200

# Bootstrap admin (created on first startup when no user exists).
# Optional: if unset, a random password is generated and logged once.
STACKPANEL_BOOTSTRAP_EMAIL=admin@stackpanel.local
STACKPANEL_BOOTSTRAP_PASSWORD=

# Settings encryption key (AES-256-GCM). Must be >= 32 chars if secrets are used.
SETTINGS_ENCRYPTION_KEY=change_me_at_least_32_characters_long

# Wow ID OpenID Connect. Register this exact HTTPS callback in Wow ID before
# enabling the plugin. Mock mode is only for local automated tests.
WOWID_MOCK=false
WOWID_ISSUER=https://account.wowcraft.cn
WOWID_CLIENT_ID=stackpanel
WOWID_CLIENT_SECRET=
WOWID_REDIRECT_URI=https://stackpanel.example/auth/oauth/wowid/callback

# Package signing. Production defaults to requiring signatures and a public key.
STACKPANEL_SIGNING_PUBLIC_KEY=
PACKAGE_SIGNATURE_REQUIRED=false
