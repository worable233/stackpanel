{
  "name": "@stackpanel/api",
  "version": "0.2.0",
  "private": true,
  "description": "StackPanel API (Fastify 5). All business logic lives here.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "pnpm --filter @stackpanel/db generate",
    "prisma:deploy": "pnpm --filter @stackpanel/db migrate:deploy",
    "prisma:status": "pnpm --filter @stackpanel/db migrate:status",
    "contract:snapshot": "tsx scripts/contract-snapshot.ts",
    "lint": "eslint .",
    "prebuild": "pnpm --filter @stackpanel/db build",
    "pretypecheck": "pnpm --filter @stackpanel/db build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@stackpanel/db": "workspace:*",
    "@stackpanel/net-guard": "workspace:*",
    "@stackpanel/plugin-store": "workspace:*",
    "@stackpanel/sdk": "workspace:*",
    "@stackpanel/spec": "workspace:*",
    "bullmq": "^6.3.10",
    "css-tree": "^3.2.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "fflate": "^0.8.2",
    "jose": "^6.2.6",
    "prom-client": "^15.1.3",
    "semver": "^7.7.2",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
