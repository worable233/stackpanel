{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
    // Do NOT add a `paths` mapping for a runtime dependency here. `tsx` honours
    // tsconfig `paths` at RUNTIME, so mapping `sharp` to its `.d.ts` makes
    // `import('sharp')` execute a declarations file (`ReferenceError: sharp is
    // not defined`) and silently disables the whole image pipeline in every
    // tsx-run process (dev, scripts, worker). sharp 0.35+ ships a `types`
    // condition in `exports`, so plain resolution is both correct and type-safe.
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "prisma.config.ts"]
}
