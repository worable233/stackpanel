{
  "name": "@stackpanel/sdk",
  "version": "0.4.0",
  "description": "Type-safe SDK for the StackPanel API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "default": "./dist/paths.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "typescript": "^6.0.3",
    "vitest": "^4"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
