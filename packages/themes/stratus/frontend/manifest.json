{
  "version": "1.0.0",
  "revision": "718dd7eec2b0",
  "entry": "frontend/dist/index.js",
  "pages": [
    {
      "path": "/",
      "component": "home",
      "data": [
        {
          "finder": "catalog.categories",
          "as": "categories"
        },
        {
          "finder": "catalog.products",
          "as": "catalogProducts",
          "input": {
            "page": 1,
            "pageSize": 8,
            "categoryId": ""
          }
        }
      ],
      "layout": "theme"
    },
    {
      "path": "/about",
      "component": "about",
      "layout": "theme"
    },
    {
      "path": "/blog",
      "component": "blog",
      "layout": "theme"
    },
    {
      "path": "/blog/:slug",
      "component": "post",
      "layout": "theme"
    },
    {
      "path": "/shop",
      "component": "shop",
      "data": [
        {
          "finder": "catalog.categories",
          "as": "categories"
        },
        {
          "finder": "catalog.products",
          "as": "catalogProducts",
          "input": {
            "page": 1,
            "pageSize": 60,
            "categoryId": "",
            "q": ""
          }
        }
      ],
      "layout": "theme"
    },
    {
      "path": "/shop/:id",
      "component": "product",
      "data": [
        {
          "finder": "store.product",
          "as": "product",
          "input": {
            "id": ":id"
          }
        },
        {
          "finder": "store.paymentMethods",
          "as": "methods"
        },
        {
          "finder": "store.viewer",
          "as": "viewer"
        }
      ],
      "layout": "theme"
    },
    {
      "path": "/shop/cart",
      "component": "cart",
      "data": [
        {
          "finder": "store.cart",
          "as": "cart"
        },
        {
          "finder": "store.paymentMethods",
          "as": "methods"
        }
      ],
      "layout": "theme"
    },
    {
      "path": "*",
      "component": "notFound",
      "layout": "theme"
    }
  ],
  "layouts": ["theme"],
  "finders": [],
  "adminRoutes": [],
  "adminActions": [],
  "actions": [],
  "accountRoutes": [],
  "accountWidgets": [],
  "files": ["frontend/dist/index.js", "frontend/dist/index.js.map"],
