    "class-variance-authority": "^0.7.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.31.0",
    "motion": "^13.5.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
