{
  "name": "@stackpanel/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Shared custom UI components (Tailwind + shadcn APIs only, no bespoke CSS).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
