{
  "name": "@stackpanel/ui",
  "version": "0.1.2",
  "private": true,
  "description": "Shared custom UI components (Tailwind + shadcn APIs only, no bespoke CSS).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./early-motion": {
      "types": "./dist/early-motion.d.ts",
      "import": "./dist/early-motion.js",
      "default": "./dist/early-motion.js"
    },
    "./error-page": {
      "types": "./dist/error-page.d.ts",
      "import": "./dist/error-page.js",
      "default": "./dist/error-page.js"
    },
    "./document-scrollbar": {
      "types": "./dist/document-scrollbar.d.ts",
      "import": "./dist/document-scrollbar.js",
      "default": "./dist/document-scrollbar.js"
    },
    "./inline-error": {
      "types": "./dist/inline-error.d.ts",
      "import": "./dist/inline-error.js",
      "default": "./dist/inline-error.js"
    },
    "./page-header": {
      "types": "./dist/page-header.d.ts",
      "import": "./dist/page-header.js",
      "default": "./dist/page-header.js"
    },
    "./section-title": {
      "types": "./dist/section-title.d.ts",
      "import": "./dist/section-title.js",
      "default": "./dist/section-title.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js",
      "default": "./dist/select.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js",
      "default": "./dist/field.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "default": "./dist/charts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "motion": "^13",
    "react": "^19",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@animate-ui/react": "2.2.1",
    "@base-ui/react": "^1.9.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.31.0",
    "motion": "^13.5.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "sideEffects": false
}
