{
  "version": "0.1.0",
  "entry": "frontend/dist/index.js",
  "pages": [],
  "layouts": [],
  "finders": [
    "market.adminPlugins",
    "market.adminThemes",
    "market.adminStatus"
  ],
  "adminRoutes": [
    {
      "path": "/",
      "component": "admin/market",
      "permission": "market.admin",
      "nav": {
        "labelKey": "nav.label",
        "groupKey": "nav.group"
      },
      "data": [
        {
          "finder": "market.adminPlugins",
          "as": "plugins"
        },
        {
          "finder": "market.adminThemes",
          "as": "themes"
        },
        {
          "finder": "market.adminStatus",
          "as": "status"
        }
      ]
    }
  ],
  "adminActions": [],
  "actions": [
    {
      "id": "market.install-plugin",
      "successFeedback": {
        "messageKey": "feedback.installed"
      },
      "method": "POST",
      "path": "/market/admin/plugins/:id/install",
      "permission": "market.admin",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 64
        }
      ]
    },
    {
      "id": "market.install-theme",
      "successFeedback": {
        "messageKey": "feedback.installed"
      },
      "method": "POST",
      "path": "/market/admin/themes/:id/install",
      "permission": "market.admin",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 64
        }
      ]
    }
  ],
  "accountRoutes": [],
  "accountWidgets": [],
