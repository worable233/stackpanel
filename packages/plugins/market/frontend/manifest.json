    {
      "id": "market.install-plugin",
      "method": "POST",
      "path": "/market/admin/plugins/:id/install",
      "permission": "market.admin",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 64
        }
      ]
    },
    {
      "id": "market.install-theme",
      "method": "POST",
      "path": "/market/admin/themes/:id/install",
      "permission": "market.admin",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 64
        }
      ]
    }
  ],
