{
  "version": "0.1.0",
  "revision": "1f67ab7bf4c5",
  "entry": "frontend/dist/index.js",
  "pages": [],
  "layouts": [],
  "finders": ["wallet.overview", "wallet.me", "wallet.adminAccounts"],
  "adminRoutes": [
    {
      "path": "/overview",
      "component": "admin/summary",
      "permission": "store.admin",
      "nav": {
        "label": "概览",
        "group": "财务",
        "order": 0
      },
      "data": [
        {
          "finder": "wallet.adminAccounts",
          "as": "wallets"
        }
      ]
    }
  ],
  "adminActions": [],
  "actions": [
    {
      "id": "wallet.create-topup",
      "method": "POST",
      "path": "/wallet/topups",
      "permission": "store.wallet",
      "input": [
        {
          "name": "amount",
          "type": "money",
          "required": true,
          "min": 100,
          "max": 2000000000
        },
        {
          "name": "providerId",
          "type": "string",
          "required": true,
          "maxLength": 64
        },
        {
          "name": "paymentMethod",
          "type": "string",
          "required": true,
          "maxLength": 64
        }
      ],
      "redirect": {
        "responsePath": "topUp.paymentUrl",
        "external": true
      }
    },
    {
      "id": "wallet.cancel-topup",
      "method": "POST",
      "path": "/wallet/topups/:id/cancel",
      "permission": "store.wallet",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        }
      ]
    }
  ],
  "accountRoutes": [
    {
      "path": "/billing",
      "component": "account/overview",
      "permission": "store.wallet",
      "nav": {
        "label": "概览",
        "group": "费用",
        "order": 0,
        "activePaths": ["/balance"]
      },
      "data": [
        {
          "finder": "wallet.overview",
          "as": "overview"
        }
      ]
    },
    {
      "path": "/balance",
      "component": "account/balance",
      "permission": "store.wallet",
      "data": [
        {
          "finder": "wallet.me",
          "as": "wallet"
        }
      ]
    },
    {
      "path": "/balance/records",
      "component": "account/records",
      "permission": "store.wallet",
      "data": [
        {
          "finder": "wallet.me",
          "as": "wallet"
        }
      ]
    }
  ],
  "accountWidgets": [
    {
      "id": "wallet-balance",
      "title": "余额",
      "component": "account/balance",
      "permission": "store.wallet"
    }
  ],
  "files": [
    "frontend/dist/admin.js",
    "frontend/dist/admin.js.map",
    "frontend/dist/index.js",
    "frontend/dist/index.js.map"
  ]
}
