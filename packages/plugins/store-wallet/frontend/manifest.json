{
  "version": "0.1.0",
  "revision": "faf86efeb39f",
  "entry": "frontend/dist/index.js",
  "pages": [],
  "layouts": [],
  "finders": ["wallet.overview", "wallet.me", "wallet.adminAccounts"],
  "adminRoutes": [
    {
      "path": "/overview",
      "component": "admin/summary",
      "permission": "store.admin",
      "nav": {
        "labelKey": "nav.overview",
        "groupKey": "nav.groupFinance",
        "order": 0
      },
      "data": [
        {
          "finder": "wallet.adminAccounts",
          "as": "wallets"
        }
      ]
    }
  ],
  "adminActions": [],
  "actions": [
    {
      "id": "wallet.create-topup",
      "method": "POST",
      "path": "/wallet/topups",
      "permission": "store.wallet",
      "input": [
        {
          "name": "amount",
          "type": "money",
          "required": true,
          "min": 100,
          "max": 2000000000
        },
        {
          "name": "providerId",
          "type": "string",
          "required": true,
          "maxLength": 64
        },
        {
          "name": "paymentMethod",
          "type": "string",
          "required": true,
          "maxLength": 64
        }
      ],
      "redirect": {
        "responsePath": "topUp.paymentUrl",
        "external": true
      }
    },
    {
      "id": "wallet.cancel-topup",
      "method": "POST",
      "path": "/wallet/topups/:id/cancel",
      "permission": "store.wallet",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        }
      ]
    }
  ],
  "accountRoutes": [
    {
      "path": "/billing",
      "component": "account/overview",
      "permission": "store.wallet",
      "nav": {
        "labelKey": "nav.overview",
        "groupKey": "nav.groupBilling",
        "order": 0,
        "activePaths": ["/balance"]
      },
      "data": [
        {
          "finder": "wallet.overview",
          "as": "overview"
        }
      ]
    },
    {
      "path": "/balance",
      "component": "account/balance",
      "permission": "store.wallet",
      "data": [
        {
          "finder": "wallet.me",
          "as": "wallet"
        }
      ]
    },
    {
      "path": "/balance/records",
      "component": "account/records",
      "permission": "store.wallet",
      "data": [
        {
          "finder": "wallet.me",
          "as": "wallet"
        }
      ]
    }
  ],
  "accountWidgets": [
    {
      "id": "wallet-balance",
      "titleKey": "widget.title",
      "component": "account/balance",
      "permission": "store.wallet"
    }
  ],
  "files": [
