{
  "name": "@stackpanel/plugin-login",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "stackpanel": {
    "builtin": true
  },
  "description": "StackPanel 内置登录插件：登录/注册页面与流程，验证与签发由平台 ctx.auth 完成。",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "node ../../../scripts/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stackpanel/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  }
}
