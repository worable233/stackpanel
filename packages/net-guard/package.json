{
  "name": "@stackpanel/net-guard",
  "version": "0.1.0",
  "description": "StackPanel 内部网络防护：公网地址校验与 SSRF 过滤（IP 字面量、保留网段、内网主机名）。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
