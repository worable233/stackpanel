// StackPanel API schema. PostgreSQL (kernel + Extension tables).
// Prisma 7: datasource URL is configured in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Core user. Credentials live on the platform (kernel); login/registration
/// flows live in the login plugin. Users belong to one or more permission
/// groups; effective permissions are the union of their groups' permissions.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  status       UserStatus    @default(ACTIVE)
  /// 邮箱所有权验证时间。启用「注册邮箱验证」后，验证通过才写入；
  /// 未启用或第三方登录创建的可为空（不代表已验证）。
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  /// 头像附件（内核媒体域）。软引用：附件被删除或尚未生成时头像回落到首字母，
  /// 所以这里不建外键——媒体域自己拥有附件的生命周期（ADR-0014 §2）。
  avatarAttachmentId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  identities    UserIdentity[]
  groups        UserGroup[]
  notifications Notification[]
  apiTokens     ApiToken[]
  agentConversations AgentConversation[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

/// 独立身份挑战（邮箱验证码）。内核拥有的短时、单次、限次凭证，按规范化
/// 邮箱与用途寻址；未注册用户尚无可靠 userId，故不落进站内通知表。
/// 只保存验证码摘要与盐，明文只在发送时出现一次，绝不进入通知/SSE/审计/日志。
model IdentityChallenge {
  id          String    @id @default(cuid())
  purpose     String // register | email_change | password_reset
  email       String // 规范化（小写）邮箱
  codeDigest  String // HMAC/pbkdf2 摘要
  codeSalt    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  locale      String?
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email, purpose, consumedAt])
  @@index([expiresAt])
  @@map("identity_challenges")
}

/// External identity bound to a local user (e.g. WowID account).
model UserIdentity {
  id          String   @id @default(cuid())
  userId      String
  providerId  String
  externalId  String
  email       String?
  displayName String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@map("user_identities")
  @@unique([providerId, externalId])
  @@index([userId])
}

/// A named collection of permissions. Groups are additive: a user's effective
/// permissions are the union of all their groups' permissions.
model PermissionGroup {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  discount    Int?              // 代理折扣（%），0-99；商店结账按用户所在组最大折扣计价，null=无折扣
  createdAt   DateTime          @default(now())
  members     UserGroup[]
  permissions GroupPermission[]

  @@map("permission_groups")
}

/// A declared permission string (e.g. `store.admin`), contributed by plugins
/// and owned by the platform. Granting to a group makes it effective.
model Permission {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  /// Optional human-readable explanation, declared by the owning plugin.
  description String?
  groups      GroupPermission[]

  @@map("permissions")
}

/// Many-to-many: user → permission group (additive roles).
model UserGroup {
  userId  String
  groupId String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// 时限成员的到期时间（会员商品授予）。null = 永久（管理员手工授予/默认组）。
  /// 判定**在读路径生效**（hasPermission/listUserGroups 过滤过期行），因此即使
  /// 清扫任务延迟，过期权益也不会继续生效；清扫只负责清理残留行与发通知。
  expiresAt DateTime?

  @@id([userId, groupId])
  @@map("user_groups")
  @@index([groupId])
  @@index([expiresAt])
}

/// Many-to-many: permission group → permission.
model GroupPermission {
  groupId      String
  permissionId String
  group        PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
  @@index([permissionId])
  @@map("group_permissions")
}

/// Append-only audit trail. No UPDATE/DELETE through the app or the DB.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  ip         String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
  @@index([createdAt])
  @@index([actorId])
}

/// Public configuration (stored as JSON). Values are non-secret.
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Encrypted secret (AES-256-GCM: iv.tag.ciphertext base64). Never returned in cleartext.
model Secret {
  key        String   @id
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("secrets")
}

/// Installed plugins and their persisted enabled state.
model Plugin {
  id         String   @id
  name       String
  version    String
  enabled    Boolean  @default(false)
  installedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("plugins")
}

model Payment {
  id              String   @id @default(cuid())
  purpose         String   @default("ORDER")
  userId          String
  orderId         String?
  methodId        String?  // → PaymentMethod
  gateway         String
  providerId      String?
  paymentMethod   String?
  merchantOrderNo String?  @unique
  amount          Int      // 结算币种金额（网关实收）
  currency        String   @default("CNY")
  orderCurrency   String?  // 订单原币种
  orderAmount     Int?     // 订单原币种金额
  fxRate          Int?     // 冻结汇率快照
  status          String   @default("PENDING")
  externalId      String?
  paymentUrl      String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  method          PaymentMethod? @relation(fields: [methodId], references: [id])

  @@map("payments")
  @@index([orderId])
  @@index([userId, createdAt])
  @@index([methodId])
}

/// 钱包账户：每用户每币种一个。本期仅使用 CNY 账户；结构为多币种预留。
///
/// `held` 是**已被预授权冻结**的金额（ADR-0022 P16）。冻结采用「从 balance 划走」
/// 的记法：`hold` 时 `balance -= amount; held += amount`，结算时 `held -= amount`
/// 并把差额退回 `balance`。因此 `balance` 始终是**当前可用余额**，普通
/// `debit`/`credit` 的判定无需感知 `held`，冻结额天然不会被其它请求花掉。
/// 不变量：`held == SUM(wallet_holds.amount WHERE status='HELD')`，
/// 由内核 sweep 与 `wallet_holds` 表对账。
model WalletAccount {
  id        String   @id @default(cuid())
  userId    String
  currency  String   @default("CNY")
  balance   Int      @default(0)
  held      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallet_accounts")
  @@unique([userId, currency])
}

/// 预授权（hold）：请求开始前冻结一笔额度，结束时按实际用量结算。
///
/// 存在的意义是消除「先查余额、使用后扣费」的并发窗口：并发请求若共享同一
/// 余额快照，多个请求都能通过余额检查，最后一个扣费失败形成坏账（PLAN §7）。
/// 有 `HELD` 记录时余额已被冻结，后来者看到的 `balance` 已扣掉冻结额。
///
/// 幂等：`(referenceType, referenceId)` 唯一，同一业务引用重复 hold 返回同一行、
/// 不会重复冻结；`status` 单向流转（HELD → SETTLED / RELEASED / EXPIRED），
/// 重复 settle/release 是 no-op。
model WalletHold {
  id            String    @id @default(cuid())
  userId        String
  currency      String    @default("CNY")
  /// 冻结金额（minor 单位）。
  amount        Int
  /// HELD | SETTLED | RELEASED | EXPIRED
  status        String    @default("HELD")
  /// 实际结算金额；SETTLED 时写入。
  settledAmount Int?
  referenceType String
  referenceId   String
  note          String?
  /// 过期时间：超过后由内核 sweep 归位，防止进程崩溃造成永久冻结。
  expiresAt     DateTime
  settledAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([referenceType, referenceId])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("wallet_holds")
}

/// 销售渠道：终端（PC/小程序/API）× 支付方式绑定，订单来源追踪。
model SalesChannel {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  terminal  String          @default("PC")
  enabled   Boolean         @default(true)
  sortOrder Int             @default(0)
  methods   PaymentMethod[]
  createdAt DateTime        @default(now())

  @@map("sales_channels")
}

/// 支付方式实例：每行 = 一个可用收款配置（epay 商户/银行信息/收款码 URL）。
model PaymentMethod {
  id         String        @id @default(cuid())
  channelId  String
  providerId String        // epay | bank_transfer | qrcode | stripe(预留)
  name       String
  enabled    Boolean       @default(true)
  scene      String        @default("PC")
  config     Json          // 商户密钥 / 银行信息 / 收款码 URL
  /// 该收款方式支持的结算币种（ISO 4217 大写）。空数组 = 支持全部已启用币种。
  currencies String[]      @default([])
  sortOrder  Int           @default(0)
  channel    SalesChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payments   Payment[]
  createdAt  DateTime      @default(now())

  @@map("payment_methods")
  @@index([channelId])
}

/// 汇率：支持成对 (from→to)，本期仅维护 外币→结算币种 单向记录（无套利闭环）。
/// rate 为整数缩放 ×1e6：结算金额 = round(原币种金额minor × rate / 1e6)。
model FxRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String   @default("CNY")
  rate         Int      // from→to，×1e6
  source       String   @default("manual") // manual | api(预留)
  /// 可选有效期；过期汇率不得用于新订单（`currency.rate_expired`）。
  validUntil   DateTime?
  updatedBy    String?
  updatedAt    DateTime @updatedAt

  @@map("fx_rates")
  @@unique([fromCurrency, toCurrency])
}

/// 币种治理状态。目录本身由内核静态白名单（SDK `CURRENCY_CATALOG`）决定，
/// 本表只保存管理员可变的启用状态与展示元数据；不允许新增/删除代码。
model CurrencyDefinition {
  code      String   @id
  name      String
  symbol    String
  minorUnit Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currency_definitions")
}

/// Immutable wallet ledger. Each business reference can affect a wallet once.
model WalletLedgerEntry {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  currency      String   @default("CNY")
  type          String
  referenceType String
  referenceId   String
  note          String?
  createdAt     DateTime @default(now())

  @@unique([referenceType, referenceId])
  @@index([userId, createdAt])
  @@map("wallet_ledger_entries")
}

/// Installed theme packages. Files live under data/themes/<id>/.
model Theme {
  id          String   @id
  name        String
  version     String
  active      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("themes")
}

/// Extension 引擎元表（ADR-0009 §6）。每个插件声明的模型一行：记录定义哈希
/// （幂等建表/迁移的依据）与引擎生成的物理表名。`ext_*` 表由引擎迁移器管理，
/// Prisma 只管理这张元表。
model ExtensionSchema {
  kind           String   @id
  pluginId       String
  definitionHash String
  tableName      String
  appliedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("extension_schema")
  @@index([pluginId])
}

/// 站内通知：按用户归属的收件箱消息（订单支付、履约失败、系统公告等）。
/// 由内核 NotificationsService 写入，插件通过 ctx.notifications.create 接入。
/// `status`/`progress`/`dedupeKey` 支撑「实况通知」：同一条 active 通知按
/// dedupeKey 原地更新标题/进度，直至 success/error，而非每次追加新行。
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 通知类型，如 order.paid / delivery.failed / announcement
  title     String
  body      String?
  link      String?  // 前端深链，如 /account/orders/:id
  data      Json?    // 插件自定义载荷
  status    String   @default("info") // info | active | success | error
  progress  Int? // 0–100，仅 active 有意义
  dedupeKey String? // 实况通知的稳定标识；与 userId 唯一
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@map("notifications")
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// 外部通知渠道的持久投递意图（审计 §5）。内核拥有收件人授权、幂等键、退避重试与
/// 失败重放；渠道插件只执行投递。按 (notification, channel) 唯一，重放合并为一行。
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String
  channelId      String
  userId         String
  /// 展开后的通知投影（JSON），避免投递时再查通知表。
  payload        Json
  /// PENDING | DELIVERED | FAILED（超过重试上限的死信）
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([notificationId, channelId])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// 用户级通知偏好（按 类型 × 渠道）。内核owns：目录、管理员策略与最终裁决；
/// 本表只存用户对「可配置」通道的显式覆盖。仅对已声明（catalog）的类型生效——
/// 未声明类型没有配置项，永远投递、不可关闭（注册/登录验证码走 identity，
/// 根本不经过通知服务）。
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  /// 通知类型（catalog type，如 order.paid）。
  type      String
  /// `inapp` 或渠道插件 id（如 smtp）。
  channelId String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channelId])
  @@index([userId])
  @@map("notification_preferences")
}

/// 平台通用 API 凭证（内核级身份能力）。明文只回显一次，库里只存哈希与前缀。
/// 有效权限 = scopes ∩ 持有者当前权限（请求时求交集，降权即时生效）。
model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String // 展示用打码前缀，如 sp_abcd…
  audience    String?
  keyHash     String    @unique // sha256(明文)
  scopes      Json      @default("[]") // 授权范围 string[]；空 = 仅身份、无任何权限
  ipAllowlist Json      @default("[]") // CIDR/单 IP；空 = 不限制
  /// 对标 #12.6：登记后该凭证的每个请求都必须带 Ed25519 请求签名；
  /// null = 只凭 Bearer（存量凭证行为不变）。
  publicKey   String?
  status      String    @default("ACTIVE") // ACTIVE|DISABLED
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage       ApiTokenUsage[]
  agentProfile AgentProfile?
  agentRuns   AgentRun[]

  @@map("api_tokens")
  @@index([userId])
  @@index([status])
}

/// Agent 画像（PLAN-agent-in-kernel §2.2）：挂在唯一凭据 `ApiToken` 上的一对一策略。
///
/// 三条铁律在数据层的落点：
/// ① 有效权限恒为 `token.scopes ∩ 主人当前权限`；`autonomy` 只在既有权限范围内放宽
///    「是否需要人点一下」，**不引入新权限** —— 所以本表没有任何权限字段。
/// ② 模型不持令牌：本表不存任何模型密钥，模型密钥只在插件/站点设置里。
/// ③ 冒用会话（`AuthUser.impersonatorId`）不得派生 Agent 运行 —— 该规则在服务层强制。
model AgentProfile {
  id               String        @id @default(cuid())
  apiTokenId       String        @unique
  /// read = 只读；propose = 写操作转待审批；act = 范围内直接执行。默认 read（§2.2）。
  autonomy         AgentAutonomy @default(read)
  /// 按自然日滚动的额度（元/分）。null = 不限。
  dailyBudgetMinor Int?
  /// 按自然日滚动的步数额度。null = 不限。超限当日不再开新运行（§4.3）。
  dailySteps       Int?
  /// 单次运行的累计花费上限（元/分），超限即停。null = 不限。
  budgetMinor      Int?
  /// 单次运行预算的计量窗口（§2.2）。取值域：'daily'（自然日滚动）| 'monthly'（自然月滚动）。
  /// 与 AgentBudgetWindow 联合类型（packages/sdk/src/agent.ts）保持一致；Prisma 侧按
  /// 仓库既有 status 字段的风格用 String 而非 enum。
  budgetWindow     String?
  /// 单次运行最大步数，防失控循环。
  maxSteps         Int           @default(50)
  /// 单次运行墙钟上限（秒）。
  maxRunSeconds    Int           @default(600)
  /// 允许调用的模型白名单 string[]（映射 llm-gateway 对外模型名）。空 = 不限。
  allowedModels    Json          @default("[]")
  /// 待审批推给谁（复用 NotificationsService）。null = 不推。
  approvalNotify   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  token            ApiToken      @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

/// 一次 Agent 运行的头（PLAN-agent-in-kernel §3.3）。
/// 逐步骤落在 `AgentStep`，因此运行天然可恢复、崩溃点可见（§3.4）。
model AgentRun {
  parentId String?
  rootId String?
  depth Int @default(0)
  @@index([rootId])
  id         String         @id @default(cuid())
  /// 触发本次运行的身份（User.id）。与 ApiTokenUsage.userId 同口径：不建 FK，保审计。
  actorId    String
  /// 本次运行使用的唯一凭据。凭据删除即级联清理运行（与 ApiTokenUsage 同口径）。
  tokenId    String
  objective  String
  /// 创建时的有效执行上限；恢复时只允许收紧。
  policy     Json?
  /// 原凭证范围内的持久创建幂等标识和参数摘要。
  requestKey String?
  requestHash String?
  status     AgentRunStatus @default(QUEUED)
  model      String?
  /// 已推进步数（= 该运行已有 AgentStep 数）。
  steps      Int            @default(0)
  spendMinor Int            @default(0)
  tokensIn   Int            @default(0)
  tokensOut  Int            @default(0)
  error      String?
  /// Set when the run leaves QUEUED for RUNNING; null while still queued.
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime       @default(now())
  token      ApiToken       @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  stepRows   AgentStep[]
  approvals  AgentApproval[]

  @@map("agent_runs")
  @@unique([tokenId, requestKey])
  @@index([actorId, startedAt])
  @@index([tokenId, startedAt])
  @@index([status])
}

/// 逐步骤回放/审计载体（PLAN-agent-in-kernel §3.3）。
/// `(runId, index)` 唯一：重放或重试同一步不会写出第二条。
model AgentStep {
  id         String        @id @default(cuid())
  runId      String
  /// 步序号，从 0 起。
  index      Int
  kind       AgentStepKind
  toolName   String?
  args       Json?
  result     Json?
  isError    Boolean       @default(false)
  tokensIn   Int           @default(0)
  tokensOut  Int           @default(0)
  costMinor  Int           @default(0)
  latencyMs  Int           @default(0)
  /// 本步对应的待审批记录（若有）。反向指针，避免与 AgentApproval.stepId 形成循环外键。
  approvalId String?
  /// 落库时刻。`(runId, index)` 已保证运行内顺序，此列用于跨运行回放/排障。
  createdAt  DateTime      @default(now())
  run        AgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvals  AgentApproval[]

  @@map("agent_steps")
  @@unique([runId, index])
  @@index([approvalId])
}

/// 待人决策的写动作（PLAN-agent-in-kernel §3.3、§4.2）。
/// `idempotencyKey` 在**提出审批时**生成并持久化，批准后执行时原样使用（§4.2）。
model AgentApproval {
  id             String              @id @default(cuid())
  runId          String
  /// The step that proposed this action. Required per §3.3; `AgentStep.approvalId`
  /// is only the optional reverse pointer, kept as a plain scalar to avoid a
  /// circular foreign key between the two tables.
  stepId         String
  capabilityId   String
  capabilityHash String?
  /// 该动作将发送的参数。null = 该能力本身无需参数 —— 与 AgentStep.args 同口径，
  /// 刻意不用 @default("{}")，以免把「无参数」与「参数为空对象」混为一谈。
  args           Json?
  /// 全文唯一：批准接口被重复调用、或执行中途重试，都不会二次扣款/二次退款。
  idempotencyKey String              @unique
  status         AgentApprovalStatus @default(PENDING)
  /// 决策人（User.id）。管理面高危能力要求其具备该能力所需权限（§5）。
  decidedBy      String?
  decidedAt      DateTime?
  expiresAt      DateTime?
  reason         String?
  /// 提出时刻。用于「按时间取某步最新一次审批」，也是审批列表的稳定排序键。
  createdAt      DateTime            @default(now())
  run            AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  step           AgentStep            @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("agent_approvals")
  @@index([runId])
  @@index([stepId])
  @@index([status, expiresAt])
}

/// Agent 自主度（§2.2）。
enum AgentAutonomy {
  read
  propose
  act
}

/// 运行状态（§3.3）。
enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  DONE
  FAILED
  CANCELLED
}

/// 步骤种类（§3.3）。
enum AgentStepKind {
  assistant
  tool_call
  tool_result
  approval
}

/// 审批状态（§3.3）。
enum AgentApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

/// 开放平台逐请求用量审计（PLAN-open-platform P1）。
/// 仅记录经 `ApiToken` 发起的调用（会话调用是内部面，不入此账）。
model ApiTokenUsage {
  id           String   @id @default(cuid())
  apiTokenId   String
  userId       String
  method       String
  path         String
  /// 命中的能力项 id；非能力项调用（如发现接口）为空。
  capabilityId String?
  statusCode   Int
  durationMs   Int      @default(0)
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  token        ApiToken @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)

  @@map("api_token_usage")
  @@index([apiTokenId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// 领域事件发件箱（Transactional Outbox，ADR-0013）。
/// 业务事实与业务写同事务落库，relay 再投递到进程内总线与 Redis Pub/Sub，
/// 保证「重启不丢、跨副本可达、at-least-once」。
model OutboxEvent {
  id          String    @id @default(cuid())
  topic       String
  payload     Json
  /// 发布来源节点，用于跨副本投递时避免回环重复。
  origin      String?
  createdAt   DateTime  @default(now())
  /// relay 认领租约；过期可被其他副本重新认领（崩溃恢复）。
  lockedAt    DateTime?
  lockedBy    String?
  publishedAt DateTime?
  attempts    Int       @default(0)
  /// 下次可尝试时间（指数退避）；null = 立即可投递。relay 只扫描 due 行。
  nextAttemptAt DateTime?
  /// 达到此尝试次数后进入停滞（parked）：不再高频重试，保留可观测。
  maxAttempts Int       @default(20)
  /// 停滞时间；非空表示已放弃自动重试（仍不删除、不伪装成功）。
  parkedAt    DateTime?
  lastError   String?

  @@map("outbox_events")
  @@index([publishedAt, createdAt])
  @@index([publishedAt, lockedAt])
  @@index([publishedAt, nextAttemptAt])
}

/// 消费幂等原语（ADR-0013：消费幂等）。同一 consumer 对同一 eventId 只处理一次。
/// 唯一键即去重键；插入冲突 = 已处理。内核与插件消费者共用。
model ProcessedEvent {
  consumer  String
  eventId   String
  createdAt DateTime @default(now())

  @@id([consumer, eventId])
  @@map("processed_events")
}

/// 组级持久消费游标：记录某 consumer 已消费到的 outbox 位置。
/// 用于「离线副本重启后按游标确认不丢」与「游标落后于保留期」告警。
model EventCursor {
  consumer  String    @id
  lastId    String?
  /// `createdAt` of the last consumed row; used with `lastId` as a composite
  /// resume point (ids alone are not guaranteed to be monotonic).
  lastAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@map("event_cursors")
}

/// 内核附件域（ADR-0014 §2）。二进制在对象存储，元数据在主库。
model Attachment {
  agentMessages AgentMessageAttachment[]
  id         String   @id @default(cuid())
  key        String   @unique
  filename   String
  mime       String
  size       Int
  width      Int?
  height     Int?
  ownerId    String?
  visibility String   @default("private")
  variants   Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("attachments")
  @@index([ownerId, createdAt])
  @@index([createdAt])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// 管理员固定的 HTTP MCP 服务；工具安全属性由管理员审核。
model AgentMcpServer {
  id String @id
  name String
  url String
  enabled Boolean @default(false)
  tools Json @default("[]")
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("agent_mcp_servers")
}

/// 对外部非事务操作采用先记意图、后记结果；未知结果不自动重放。
model AgentOperation {
  id String @id
  actorId String
  runId String?
  kind String
  requestHash String
  status String @default("STARTED")
  result Json?
  reservedMinor Int @default(0)
  costMinor Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([actorId, createdAt])
  @@index([runId, kind])
  @@map("agent_operations")
}

/// 跨进程后台执行授权；凭证单独加密保存在 Secret，队列只带 runId。
model AgentDispatch {
  runId String @id
  actorId String
  clientIp String
  expiresAt DateTime
  pending Boolean @default(true)
  lockedUntil DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([pending, lockedUntil])
  @@map("agent_dispatches")
}

/// 站内通知的持久待投递记录；去重键在通知服务中保持稳定。
model AgentDelivery {
  id String @id
  userId String
  runId String
  payload Json
  deliveredAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([deliveredAt, nextAttemptAt])
  @@index([runId])
  @@map("agent_deliveries")
}

model AgentOAuthClient {
  id String @id
  name String
  redirectUris Json
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  @@map("agent_oauth_clients")
}
model AgentOAuthGrant {
  hash String @id
  familyId String
  @@index([familyId])
  kind String
  clientId String
  userId String
  scopes Json
  redirectUri String?
  challenge String?
  tokenId String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@map("agent_oauth_grants")
}

/// User-owned chat history. Saving a message does not start an Agent run.
model AgentConversation {
  id String @id
  userId String
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentChatMessage[]

  @@index([userId, createdAt, id])
  @@map("agent_conversations")
}

model AgentChatMessage {
  id String @id
  conversationId String
  content String
  reasoning String @default("均衡")
  createdAt DateTime @default(now())
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments AgentMessageAttachment[]

  @@index([conversationId, createdAt, id])
  @@map("agent_chat_messages")
}

model AgentMessageAttachment {
  messageId String
  attachmentId String
  message AgentChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@id([messageId, attachmentId])
  @@map("agent_message_attachments")
}

/// 逐页 SEO 覆写（对标 #12.4）。
///
/// 内容归属仍在插件（`seo.provider` 给实体级元数据），这张表只存运营要改的
/// 那几个字段，并在渲染时**逐字段**压在 provider 之上 —— 改标题不该连带抹掉
/// 商品的 JSON-LD。`noindex` 同时约束 sitemap：被标记的页面不得出现在 sitemap。
model SeoPage {
  id          String   @id @default(cuid())
  /// 规范化路径：以 `/` 开头、无尾斜杠、不含 query/hash，唯一。
  path        String   @unique
  title       String?
  description String?
  ogImage     String?
  canonical   String?
  noindex     Boolean  @default(false)
  /// 最后修改人（用户 id）；系统导入时为空。
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([noindex])
  @@map("seo_pages")
}

/// 菜单显示覆写（对标 #12.3）：排序、改名、隐藏，以及运营自定义的链接。
/// 只影响「怎么显示」，不参与任何授权判断 —— 隐藏菜单不等于禁止访问。
model NavEntry {
  id String @id
  surface String
  href String
  label String?
  sortOrder Int?
  hidden Boolean @default(false)
  custom Boolean @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([surface, href])
  @@index([surface])
  @@map("nav_entries")
}

/// 任务调度的跨副本租约（对标 #12.5）：无 Redis 时用数据库做单实例保证。
///
/// 进程内后端的每个副本都会按时触发定时器，执行前抢一次租约、抢到才跑；
/// 租约靠 `expiresAtMs` 自然过期，持有者被 kill 后由下一个副本接手。
/// 有 Redis 时走 BullMQ 抢占，这张表不参与。
model KernelJobLease {
  /// 任务全名（`<owner>.<name>`）。
  name String @id
  /// 持有者标识，仅用于排查「上一轮是谁在跑」。
  holder String
  /// 租约到期时间（epoch ms）。
  expiresAtMs BigInt
  // 表名用 snake_case，与其余表一致。
  @@map("kernel_job_leases")
}
