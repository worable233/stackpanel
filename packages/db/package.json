{
  "name": "@stackpanel/db",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Prisma schema, migrations and client factory shared by the API and plugins.",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "prepare": "prisma generate && tsup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stackpanel/sdk": "workspace:*",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsup": "^8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
