{
  "name": "@stackpanel/spec",
  "version": "0.4.0",
  "description": "StackPanel 协议契约单一来源：内核 API 版本、OpenAPI 投影与兼容性快照。",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
