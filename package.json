{
  "name": "stackpanel",
  "version": "0.2.0",
  "private": true,
  "description": "API-first, microkernel plugin-based digital goods / hosting business management system.",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:frontend": "node scripts/build-frontend.mjs",
    "build": "pnpm build:frontend && pnpm -r build",
    "typecheck": "pnpm build:frontend && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "i18n:scan": "node scripts/scan-i18n-literals.mjs",
    "i18n:check": "node scripts/scan-i18n-literals.mjs --check",
    "i18n:packages": "node scripts/check-package-catalogs.mjs",
    "i18n:hant": "node scripts/i18n-hant.mjs",
    "i18n:hant:check": "node scripts/i18n-hant.mjs --check",
    "i18n:baseline": "node scripts/scan-i18n-literals.mjs --update-baseline",
    "verify:s2": "node scripts/verify-s2.mjs",
    "smoke:cluster": "node scripts/smoke-cluster.mjs",
    "verify:lb": "node scripts/verify-lb.mjs",
    "dev": "pnpm -r --if-present --parallel dev",
    "dev:watch": "node scripts/dev-watch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "bash scripts/licenses.sh",
    "plugin:create": "node scripts/create-plugin.mjs",
    "plugin:pack": "pnpm --filter @stackpanel/api exec tsx scripts/pack-plugin.ts",
    "package:sign": "node scripts/sign-package.mjs",
    "release:key": "node scripts/release/generate-key.mjs",
    "release:manifest": "node scripts/release/build-manifest.mjs",
    "release:catalog": "node scripts/release/build-catalog.mjs",
    "release:kernel-manifest": "node scripts/release/build-kernel-manifest.mjs",
    "release:kernel-artifact": "node scripts/release/build-kernel-artifact.mjs",
    "release:verify-catalog": "node scripts/release/verify-catalog.mjs",
    "release:rehearse": "node scripts/release/rehearse-distribution.mjs",
    "release:updater-drill": "node scripts/release/updater-drill.mjs",
    "release:acceptance-report": "node scripts/release/acceptance-report.mjs",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "backup:drill": "bash scripts/backup-drill.sh",
    "install:local": "bash scripts/install.sh",
    "deploy": "bash scripts/deploy.sh",
    "docker:up": "docker compose --env-file docker/.env up -d --build",
    "docker:down": "docker compose --env-file docker/.env down",
    "docker:logs": "docker compose --env-file docker/.env logs -f --tail=200",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs && pm2 delete ecosystem.config.cjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install",
    "probe:v10": "node scripts/probe-zjmf-v10.mjs",
    "release:upgrade-runner": "node scripts/release/build-upgrade-runner.mjs",
    "install:artifact": "bash scripts/install-artifact.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stackpanel/db": "workspace:*",
    "eslint": "^10.8.0",
    "globals": "^17.13.0",
    "license-checker": "^25.0.1",
    "opencc-js": "^1.4.2",
    "pm2": "^7.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@stackpanel/net-guard": "workspace:*",
    "@stackpanel/sdk": "workspace:*",
    "@stackpanel/ui": "workspace:*",
    "emoji-picker-react": "^4.19.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "license": "MIT"
}
