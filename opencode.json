{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.7.0"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.79"],
      "enabled": true,
      "environment": {
        "BROWSER": "chromium"
      },
      "timeout": 30000
    },
    "magicui": {
      "type": "local",
      "command": ["npx", "-y", "@magicuidesign/mcp@latest"],
      "enabled": true,
      "timeout": 30000
    },
    "servers": {
      "shadcn": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "shadcn@latest",
          "mcp"
        ],
        "cwd": "apps/web"
      }
    }
  }
}
